# BetFit Arena — Zero-Cost Production Environment Configuration
# Copy this file to .env and fill in your free project keys.

# 1. Supabase Free PostgreSQL & Auth (https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Server JWT Secret (any random 32+ character string)
JWT_SECRET=betfit_production_secret_key_2026_super_secure

# 3. Port for local development
PORT=3001
NODE_ENV=production
